DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Direct (non-pooled) URL — required for prisma db push / migrate on Neon
DATABASE_URL_DIRECT="postgresql://user:pass@host/db?sslmode=require"

AUTH_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP="233246572540"

# Payment provider: moolre | paystack (auto-detects if unset)
PAYMENT_PROVIDER="moolre"

# Moolre (Ghana MoMo + hosted checkout) — https://docs.moolre.com
MOOLRE_API_USER=""
MOOLRE_PUBLIC_KEY=""
MOOLRE_ACCOUNT_NUMBER=""
MOOLRE_BUSINESS_EMAIL="fruitfusion45@gmail.com"
MOOLRE_SANDBOX="true"

# Paystack (alternative) — leave empty if using Moolre
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Default admin (seeded on first run)
ADMIN_EMAIL="admin@fruitfusion.gh"
ADMIN_PASSWORD="FruitFusion2026!"
